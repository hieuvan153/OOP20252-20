<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- In-game manual - Isolated Version for Scene Builder -->
<StackPane xmlns:fx="http://javafx.com/fxml" style="-fx-background-color: #87CEEB;">
    <children>
        <VBox alignment="CENTER" spacing="16">
            <padding>
                <Insets topRightBottomLeft="24"/>
            </padding>
            <children>
                <Label text="HELP" styleClass="plaque, title-lg"/>

                <Label fx:id="body" text="[The detailed game instructions will be displayed in this area]" styleClass="parchment-card, ink-text, help-body"/>

                <Button text="BACK" styleClass="btn-wood" />
            </children>
        </VBox>
    </children>
</StackPane>
