<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        prefHeight="720"
        prefWidth="1280"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="view.screen_controller.ShopViewController">

    <!-- ================= TOP ================= -->

    <top>

        <StackPane BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label style="-fx-font-size: 36;                           -fx-font-weight: bold;" text="SHOP" />

        </StackPane>

    </top>


    <!-- ================= CENTER ================= -->

    <center>

        <VBox alignment="TOP_CENTER" spacing="20">

            <padding>
                <Insets bottom="10" left="30" right="30" top="10" />
            </padding>

            <TabPane prefHeight="500" prefWidth="950" tabClosingPolicy="UNAVAILABLE">

                <tabs>

                    <!-- SEEDS -->

                    <Tab text="Seeds">

                        <content>

                            <FlowPane fx:id="seedPane" hgap="20" prefHeight="500" prefWidth="900" vgap="20">

                                <padding>
                                    <Insets bottom="20" left="20" right="20" top="20" />
                                </padding>

                            </FlowPane>

                        </content>

                    </Tab>


                    <!-- FERTILIZER -->

                    <Tab text="Fertilizer">

                        <content>

                            <FlowPane fx:id="fertilizerPane" hgap="20" prefHeight="500" prefWidth="900" vgap="20">

                                <padding>
                                    <Insets bottom="20" left="20" right="20" top="20" />
                                </padding>

                            </FlowPane>

                        </content>

                    </Tab>

                </tabs>

            </TabPane>

        </VBox>

    </center>


    <!-- ================= BOTTOM ================= -->

    <bottom>

        <HBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15" left="30" right="30" top="15" />
            </padding>

            <!-- MONEY -->

            <Label style="-fx-font-size: 24;                           -fx-font-weight: bold;" text="\$200" />

            <Pane HBox.hgrow="ALWAYS" />


            <!-- PAGE CONTROL -->

            <HBox alignment="CENTER" spacing="10">

                <Button prefHeight="40" prefWidth="50" text="&lt;" />

                <Label style="-fx-font-size: 20;" text="PAGE 1 / 2" />

                <Button prefHeight="40" prefWidth="50" text="&gt;" />

            </HBox>

            <Pane HBox.hgrow="ALWAYS" />


            <!-- BACK -->

            <Button onAction="#backToGame" prefHeight="40" prefWidth="100" text="BACK" />

        </HBox>

    </bottom>

</BorderPane>
