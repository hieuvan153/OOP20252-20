<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1280"
            prefHeight="720"
            style="-fx-background-color: linear-gradient(to bottom, #92c5d6 0%, #bfe3c5 45%, #5b9b35 100%);">

    <!-- ================= TOP ================= -->

    <top>

        <StackPane BorderPane.alignment="CENTER">

            <padding>
                <Insets top="30" bottom="20"/>
            </padding>

            <Label text="SHOP"
                   style="-fx-font-size: 42;
                          -fx-font-family: 'Consolas';
                          -fx-font-weight: bold;
                          -fx-text-fill: #2f1d0f;
                          -fx-background-color: #ead9ab;
                          -fx-border-color: #4b2d12;
                          -fx-border-width: 5;
                          -fx-background-radius: 14;
                          -fx-border-radius: 14;
                          -fx-padding: 12 40 12 40;" />

        </StackPane>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="20">

            <padding>
                <Insets top="10" right="40" bottom="10" left="40"/>
            </padding>

            <!-- TAB PANE -->

            <TabPane prefWidth="950"
                     prefHeight="500"
                     tabClosingPolicy="UNAVAILABLE"
                     style="-fx-font-size: 18;">

                <tabs>

                    <!-- SEEDS -->

                    <Tab text="Seeds">

                        <content>

                            <AnchorPane>

                                <children>

                                    <FlowPane fx:id="seedPane"
                                              prefWidth="900"
                                              prefHeight="500"
                                              hgap="20"
                                              vgap="20"
                                              layoutX="20"
                                              layoutY="20"
                                              style="-fx-background-color: rgba(255,245,220,0.75);
                                                     -fx-background-radius: 18;
                                                     -fx-padding: 25;" />

                                </children>

                            </AnchorPane>

                        </content>

                    </Tab>

                    <!-- FERTILIZER -->

                    <Tab text="Fertilizer">

                        <content>

                            <AnchorPane>

                                <children>

                                    <FlowPane fx:id="fertilizerPane"
                                              prefWidth="900"
                                              prefHeight="500"
                                              hgap="20"
                                              vgap="20"
                                              layoutX="20"
                                              layoutY="20"
                                              style="-fx-background-color: rgba(255,245,220,0.75);
                                                     -fx-background-radius: 18;
                                                     -fx-padding: 25;" />

                                </children>

                            </AnchorPane>

                        </content>

                    </Tab>

                </tabs>

            </TabPane>

        </VBox>

    </center>

    <!-- ================= BOTTOM ================= -->

    <bottom>

        <HBox alignment="CENTER"
              spacing="30"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="15" right="40" bottom="25" left="40"/>
            </padding>

            <!-- MONEY -->

            <Label text="\$200"
                   style="-fx-font-size: 28;
                          -fx-font-family: 'Consolas';
                          -fx-font-weight: bold;
                          -fx-text-fill: #ffd54a;
                          -fx-background-color: #2f1d0f;
                          -fx-background-radius: 10;
                          -fx-padding: 8 20 8 20;
                          -fx-border-color: #c98f3d;
                          -fx-border-radius: 10;
                          -fx-border-width: 3;" />

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- PAGE CONTROL -->

            <HBox alignment="CENTER"
                  spacing="15">

                <Button text="&lt;"
                        prefWidth="60"
                        prefHeight="45"
                        style="-fx-font-size: 20;
                               -fx-font-weight: bold;
                               -fx-background-color: #9c6a34;
                               -fx-text-fill: white;
                               -fx-background-radius: 10;" />

                <Label text="PAGE 1 / 2"
                       style="-fx-font-size: 26;
                              -fx-font-family: 'Consolas';
                              -fx-text-fill: #ffe7a8;" />

                <Button text="&gt;"
                        prefWidth="60"
                        prefHeight="45"
                        style="-fx-font-size: 20;
                               -fx-font-weight: bold;
                               -fx-background-color: #9c6a34;
                               -fx-text-fill: white;
                               -fx-background-radius: 10;" />

            </HBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- BACK BUTTON -->

            <Button text="BACK"
                    prefWidth="110"
                    prefHeight="50"
                    style="-fx-font-size: 20;
                           -fx-font-weight: bold;
                           -fx-background-color: #9c6a34;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;
                           -fx-border-radius: 10;
                           -fx-border-color: #4b2d12;
                           -fx-border-width: 3;" />

        </HBox>

    </bottom>

</BorderPane>